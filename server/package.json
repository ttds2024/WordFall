{
  "name": "wordfall-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.mjs",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.27",
    "@colyseus/schema": "^5.0.45",
    "@colyseus/ws-transport": "^0.18.4"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.9",
    "@colyseus/testing": "^0.18.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "description": "WordFall multiplayer server (Colyseus)"
}
